{
  "schemaVersion": "2.2.0",
  "resources": {
    "overlay": {
      "enabled": true,
      "required": true
    },
    "linux": {
      "user": {
        "groups": [
          "gpu"
        ],
        "conditionalGroups": [
          "pipewire"
        ]
      }
    }
  },
  "acapPackageConf": {
    "setup": {
      "appName": "acap_quake2",
      "friendlyName": "ACAP Quake II",
      "vendor": "-",
      "vendorId": "1234567890",
      "version": "0.1.0",
      "compatibleOsVersions": [
        {
          "max": "13"
        }
      ],
      "runMode": "never"
    },
    "configuration": {
      "reverseProxy": [
        {
          "apiPath": "input",
          "target": "ws://127.0.0.1:9000",
          "access": "admin"
        }
      ],
      "settingPage": "index.html"
    }
  }
}
