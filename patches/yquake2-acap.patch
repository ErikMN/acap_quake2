+#include "overlay.h"
+#endif
+
+#ifdef USE_SDL3
+#include <SDL3/SDL.h>
+#else
+#include <SDL2/SDL.h>
+#endif
+
+static SDL_Window* window = NULL;
+#ifndef YQ2_ACAP
+static SDL_GLContext context = NULL;
+#else
+static struct gpu_context acap_gpu;
+static struct overlay_context acap_overlay;
+static qboolean acap_gpu_initialized = false;
+static qboolean acap_overlay_initialized = false;
+#endif
+static qboolean vsyncActive = false;
+qboolean IsHighDPIaware = false;
