+void GL3_GetDrawableSize(int* width, int* height)
+{
+#ifdef YQ2_ACAP
+	if (acap_overlay.width && acap_overlay.height)
+	{
+		*width = (int)acap_overlay.width;
+		*height = (int)acap_overlay.height;
+	}
+	else
+	{
+		*width = vid.width;
+		*height = vid.height;
+	}
+#elif defined(USE_SDL3)
+	SDL_GetWindowSizeInPixels(window, width, height);
+#else
+	SDL_GL_GetDrawableSize(window, width, height);
+#endif
+}
+
+/*
+ * Shuts the GL context down.
+ */
+void GL3_ShutdownContext()
+{
+#ifdef YQ2_ACAP
+	if (acap_overlay_initialized)
+	{
+		overlay_context_destroy(&acap_overlay);
+		acap_overlay_initialized = false;
+	}
+
+	if (acap_gpu_initialized)
+	{
+		gpu_context_destroy(&acap_gpu);
+		acap_gpu_initialized = false;
+	}
+
+	window = NULL;
+#else
+	if (window)
+	{
+		if(context)
+		{
+#ifdef USE_SDL3
+			SDL_GL_DestroyContext(context);
+#else
+			SDL_GL_DeleteContext(context);
+#endif
+			context = NULL;
+		}
+	}
+#endif
+}
+
+qboolean
+GL3_BeginOutputFrame(void)
+{
+#ifdef YQ2_ACAP
+	return overlay_context_begin_frame(&acap_overlay, &acap_gpu);
+#else
+	return true;
+#endif
+}
+
+void
+GL3_BindOutputFramebuffer(void)
+{
+#ifdef YQ2_ACAP
+	overlay_context_bind_frame(&acap_overlay);
+#else
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+#endif
+}
