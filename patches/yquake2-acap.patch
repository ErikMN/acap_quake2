+void GL3_SwapWindow(void)
+{
+#ifdef YQ2_ACAP
+	if (!overlay_context_end_frame(&acap_overlay))
+	{
+		Com_Error(ERR_FATAL, "Failed to submit ACAP overlay frame");
+	}
+#else
+	SDL_GL_SwapWindow(window);
+#endif
+}
