+static struct io_node *io_list_get_by_path(char *path)
+{
+    struct io_node *n, *temp;
+    spa_list_for_each_safe (n, temp, &hotplug_io_list, link) {
+        if (SDL_strcmp(n->path, path) == 0) {
+            return n;
+        }
+    }
+    return NULL;
+}
+
+static struct io_node *io_list_get_axis_output(void)
+{
+    struct io_node *n;
+    struct io_node *selected = NULL;
+    unsigned int selected_device = 0;
+    unsigned int selected_output = 0;
+
+    spa_list_for_each (n, &hotplug_io_list, link) {
+        unsigned int device;
+        unsigned int output;
+        char trailing;
+
+        if (n->is_capture ||
+            SDL_sscanf(n->path, "AudioDevice%uOutput%u%c", &device, &output, &trailing) != 2) {
+            continue;
+        }
+
+        if (!selected || device < selected_device ||
+            (device == selected_device && output < selected_output)) {
+            selected = n;
+            selected_device = device;
+            selected_output = output;
+        }
+    }
+
+    return selected;
+}
 
